:root {
  --bg: #fbfbfa; --fg: #1d1f21; --muted: #6b6f76; --line: #e2e3e5; --card: #ffffff;
  --pass: #1a7f37; --warn: #9a6700; --fail: #cf222e; --error: #8250df; --skip: #8c959f;
  --improved: #1a7f37; --regressed: #cf222e; --changed: #9a6700; --new: #0969da; --gone: #8c959f;
  --tint-pass: #dafbe1; --tint-warn: #fff8c5; --tint-fail: #ffebe9; --tint-error: #fbefff; --tint-skip: #f3f4f6;
  --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #111315; --fg: #e6e7e9; --muted: #9aa0a6; --line: #2d3136; --card: #181b1f;
    --pass: #3fb950; --warn: #d29922; --fail: #f85149; --error: #bc8cff; --skip: #8b949e;
    --improved: #3fb950; --regressed: #f85149; --changed: #d29922; --new: #58a6ff; --gone: #8b949e;
    --tint-pass: #12261a; --tint-warn: #2b2411; --tint-fail: #2d1517; --tint-error: #231a33; --tint-skip: #1e2125;
  }
}
* { box-sizing: border-box; }
body { margin: 0; background: var(--bg); color: var(--fg);
  font: 14px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
main { max-width: 1200px; margin: 0 auto; padding: 32px 24px 64px; }
h1 { font-size: 22px; margin: 0 0 4px; font-weight: 650; }
h2 { font-size: 16px; margin: 36px 0 12px; font-weight: 650; padding-bottom: 6px; border-bottom: 1px solid var(--line); }
h3 { font-size: 14px; margin: 20px 0 8px; font-weight: 600; color: var(--muted); }
.sub { color: var(--muted); }
.meta { display: flex; flex-wrap: wrap; gap: 6px 20px; color: var(--muted); margin-top: 6px; }
.meta b { color: var(--fg); font-weight: 600; }
table { width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums; }
th, td { text-align: left; padding: 6px 10px; border-bottom: 1px solid var(--line); vertical-align: top; }
th { font-weight: 600; color: var(--muted); font-size: 12px; text-transform: uppercase; letter-spacing: .03em; }
td.num, th.num { text-align: right; }
code, pre, .mono { font-family: var(--mono); font-size: 12.5px; }
pre { background: var(--card); border: 1px solid var(--line); border-radius: 6px; padding: 10px 12px;
  overflow-x: auto; white-space: pre-wrap; word-break: break-word; margin: 8px 0; }
.grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 16px 28px; }
.grid > * { align-self: start; }
.kv td:first-child { color: var(--muted); width: 45%; }
.tiles { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 20px; }
.tile { background: var(--card); border: 1px solid var(--line); border-radius: 8px; padding: 10px 16px; min-width: 110px; }
.tile .n { font-size: 24px; font-weight: 650; font-variant-numeric: tabular-nums; }
.tile .l { color: var(--muted); font-size: 12px; text-transform: uppercase; letter-spacing: .04em; }
.badge { display: inline-block; min-width: 52px; text-align: center; font-size: 11px; font-weight: 700;
  letter-spacing: .05em; text-transform: uppercase; padding: 2px 8px; border-radius: 999px; }
.s-pass { color: var(--pass); background: var(--tint-pass); }
.s-warn { color: var(--warn); background: var(--tint-warn); }
.s-fail { color: var(--fail); background: var(--tint-fail); }
.s-error { color: var(--error); background: var(--tint-error); }
.s-skip { color: var(--skip); background: var(--tint-skip); }
.t-pass .n { color: var(--pass); } .t-warn .n { color: var(--warn); } .t-fail .n { color: var(--fail); }
.t-error .n { color: var(--error); } .t-skip .n { color: var(--skip); }
.v-improved { color: var(--improved); font-weight: 600; } .v-regressed { color: var(--regressed); font-weight: 600; }
.v-changed { color: var(--changed); } .v-new { color: var(--new); } .v-gone { color: var(--gone); }
.notice { border-left: 3px solid var(--warn); background: var(--tint-warn); padding: 8px 12px; border-radius: 4px; margin: 8px 0; }
details.check { border-bottom: 1px solid var(--line); }
details.check > summary { list-style: none; cursor: pointer; display: grid;
  grid-template-columns: 70px minmax(180px, 280px) 1fr 70px; gap: 12px; align-items: baseline; padding: 8px 4px; }
details.check > summary::-webkit-details-marker { display: none; }
details.check > summary:hover { background: var(--card); }
details.check[open] > summary { background: var(--card); }
details.check .body { padding: 4px 8px 16px 86px; }
.km { color: var(--muted); font-family: var(--mono); font-size: 12px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.dur { text-align: right; color: var(--muted); font-variant-numeric: tabular-nums; }
.msg { margin: 4px 0 8px; }
details.more > summary { cursor: pointer; color: var(--muted); margin: 8px 0; }
footer { margin-top: 48px; color: var(--muted); font-size: 12px; }
.toggle { margin: 12px 0; color: var(--muted); user-select: none; }
#show-all:not(:checked) ~ section tr.same { display: none; }
